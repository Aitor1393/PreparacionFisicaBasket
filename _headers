# Cabeceras para Cloudflare Pages. Se copian a _sitio/ al preparar el sitio.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# Los datos se revalidan siempre. Cuestan poco y así un cambio en las fuentes
# se ve en cuanto se despliega, sin esperar a que caduque una caché.
/data/*
  Cache-Control: no-cache

# Si el service worker se queda cacheado, la web se queda congelada en una
# versión vieja y no hay forma de sacarla de ahí desde el móvil.
/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache
